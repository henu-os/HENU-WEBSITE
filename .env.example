# ==============================================================================
# HENU OFFICIAL WEBSITE — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Security Rules (Document 03 §24):
# 1. Never commit real secrets to source control.
# 2. Variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# 3. Privileged keys (SERVICE_ROLE_KEY) MUST NEVER have the NEXT_PUBLIC_ prefix.
# 4. In development, copy this file to .env.local and configure local values.
# ==============================================================================

# Application Environment
NODE_ENV=development
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Public Client — Browser & Anon)
NEXT_PUBLIC_SUPABASE_URL=https://placeholder.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder-anon-key

# Supabase (Server-Only — High-Privilege Service Role)
# DO NOT ADD NEXT_PUBLIC_ PREFIX. Confined to src/server/*
SUPABASE_SERVICE_ROLE_KEY=placeholder-service-role-key

# Admin Authentication & Sessions
ADMIN_SESSION_SECRET=placeholder-session-secret-min-32-chars-length
ADMIN_ALLOWED_EMAILS=admin@henu.local

# External Integrations (Optional in Phase 0)
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/henuos
RATE_LIMIT_KV_REST_API_URL=
RATE_LIMIT_KV_REST_API_TOKEN=
RESEND_API_KEY=
ENQUIRY_NOTIFICATION_EMAIL=admin@henu.local
